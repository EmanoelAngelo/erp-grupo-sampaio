# DEVORA ERP — Staging integrado (Homologação 07)
# Copie para .env.staging e NUNCA use secrets de Produção.

# ─── Ambiente ───
DEVORA_API_ENV=staging
# Homologacao e ensaio de producao: as travas valem (chave fraca e variavel
# aposentada ligada recusam subir). NODE_ENV=production faz o mesmo, pelos
# dois nomes.
NODE_ENV=production
DEVORA_API_PORT=8787
# Onde a API escuta. 127.0.0.1 = so a propria maquina: o proxy reverso recebe
# da internet e encaminha. Nao use 0.0.0.0 sem firewall.
DEVORA_API_HOST=127.0.0.1
DEVORA_FRONTEND_ORIGIN=https://staging-admin.example.com,https://staging-store.example.com

# QUANTOS PROXIES ESTAO NA FRENTE DESTE SERVIDOR.
#
# O limite de taxa e o controle de forca bruta do login contam por IP. Atras de
# um proxy reverso, o IP visto e o DO PROXY: as seis operacoes, todos os caixas
# e todo visitante da vitrine dividem o mesmo balde, e um robo na vitrine
# derruba a venda do balcao com 429.
#
# Ligar faz o servidor acreditar no X-Forwarded-For, que e a coisa mais barata
# de forjar — quem mandar um IP diferente a cada tentativa some do controle de
# forca bruta. Por isso o valor e SEU: e o numero de saltos confiaveis.
#
#   0  servido direto (padrao, e o certo sem proxy)
#   1  um proxy reverso na frente (nginx, Caddy, Traefik)
#   2  CDN na frente do proxy
DEVORA_TRUST_PROXY=0

DEVORA_DATABASE_PATH=./server/data/staging-grupo-sampaio.db
# Endereco publico do QR da plaquinha. Em staging aponta para o staging, senao a
# etiqueta de teste manda o celular para a loja de verdade.
GRUPO_SAMPAIO_PUBLIC_URL=https://staging-admin.example.com
# Identidade deste no na central. Em homologacao, use um nome proprio para os
# fatos de teste nao se misturarem aos da loja.
GRUPO_SAMPAIO_NODE_ID=homologacao

# ─── Segredos staging (gerar valores únicos — NÃO reutilizar produção) ───
DEVORA_JWT_SECRET=change-me-staging-jwt-secret
DEVORA_ENCRYPTION_KEY=change-me-staging-32-chars-key!!

# ─── Frontend (Vite) — variável de BUILD; o frontend lê SÓ esta ───
# Embutida no bundle em `npm run build:frontend`. Os liga/desliga de
# integração são do SERVIDOR (ASAAS_ENABLED etc., abaixo).
VITE_API_BASE_URL=https://staging-api.example.com

# ─── Backend — integrações (produção SEMPRE false no staging) ───
# Credenciais operacionais (Asaas, CSC, carriers, terminals) devem ser cadastradas
# pela Central de Integrações: Administração → Integrações
# Variáveis abaixo são fallback para desenvolvimento/testes quando permitido.
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_AUTH_TOKEN=
ASAAS_WEBHOOK_PUBLIC_URL=
ASAAS_TIMEOUT_MS=30000
ASAAS_MAX_RETRIES=3
ASAAS_PRODUCTION_ENABLED=false
ASAAS_SYNC_INTERVAL_MINUTES=30
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_BASE_URL=https://api.asaas.com/api/v3
NFE_PRODUCTION_ENABLED=false
NFE_HOMOLOGATION_TESTS=false
NFCE_PRODUCTION_ENABLED=false
NFCE_HOMOLOGATION_TESTS=false
LOGISTICS_EXTERNAL_ENABLED=false
LOGISTICS_PRODUCTION_ENABLED=false
LOGISTICS_MELHOR_ENVIO_SANDBOX_URL=https://sandbox.melhorenvio.com.br
LOGISTICS_MELHOR_ENVIO_PRODUCTION_URL=https://melhorenvio.com.br
# De quantos em quantos minutos a agenda consulta o rastreio dos envios a
# caminho no Melhor Envio. 0 desliga a agenda (o botão da ficha continua).
LOGISTICS_TRACKING_SYNC_MINUTES=60
PAYMENT_TERMINAL_ENABLED=true
PAYMENT_TERMINAL_PRODUCTION_ENABLED=false
PAYMENT_TERMINAL_HOMOLOGATION_TESTS=false
ECOMMERCE_ENABLED=true
ECOMMERCE_PRODUCTION_ENABLED=false
ECOMMERCE_HOMOLOGATION_TESTS=false

# ─── E-commerce staging (preencher no deploy real) ───
ECOMMERCE_STOREFRONT_PUBLIC_BASE_URL=https://staging-store.example.com
ECOMMERCE_ADMIN_PUBLIC_URL=https://staging-admin.example.com
ECOMMERCE_STOREFRONT_CNAME_TARGET=
ECOMMERCE_STOREFRONT_A_RECORD=
ECOMMERCE_DNS_TXT_HOST=_devora-verify
ECOMMERCE_DNS_AUTO_VALIDATE=false
ECOMMERCE_STOREFRONT_ORIGINS=https://staging-store.example.com

LOG_LEVEL=info

# ─── CENTRAL E BACKUP REMOTO (Supabase) ───
# Em homologacao, uma conta/projeto SEPARADO da producao — nunca a mesma.
DEVORA_SUPABASE_URL=
DEVORA_SUPABASE_SERVICE_KEY=
DEVORA_SUPABASE_BUCKET=backups-homologacao

# ─── ONDE FICAM OS DADOS ───
#
# Backup local: deixe em OUTRO disco (pen drive, segundo HD, pasta
# sincronizada). Vazio = server/data/backups, vizinha do banco, e o servidor
# avisa no log a cada execucao.
DEVORA_BACKUP_DIR=
# Hora do diario (0 a 23), pelo relogio da loja. Vazio = 3 (03:00). A copia
# do banco e o envio das fotos rodam a essa hora; ao subir, o servidor so tira
# copia se nao houver diario de menos de 20 h.
DEVORA_BACKUP_HORA=
# Imagens enviadas (logo de loja, foto de produto, foto de OS). Vazio = os
# caminhos historicos (<raiz>/data/uploads). Trocar depois exige MOVER os
# arquivos junto, senao os links gravados no banco apontam para o nada.
DEVORA_UPLOADS_DIR=
#
# Retencao do bucket (avo-pai-filho). Vazio = 14 diarios, 8 semanais, 12
# mensais, minimo 7. Valor invalido cai no padrao em vez de virar "apague tudo".
DEVORA_BACKUP_RETENCAO_DIARIOS=
DEVORA_BACKUP_RETENCAO_SEMANAIS=
DEVORA_BACKUP_RETENCAO_MENSAIS=
DEVORA_BACKUP_RETENCAO_MINIMO=

# ─── CORREIO DE SAIDA (SMTP) ───
#
# Sem estas, a fila de e-mail ACUMULA em vez de falhar — e nela ficam o codigo
# de verificacao da conta do cliente e a recuperacao de senha. O carteiro sobe
# sempre e diz no log que a credencial falta. EMAIL_ENABLED=false monta e
# enfileira sem mandar nada. A API le estas chaves SO AO SUBIR: mudou, reinicie.
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ─── ADMINISTRADOR INICIAL (bootstrap) ───
# A primeira subida cria as seis empresas e a conta `admin` com esta senha,
# PROVISORIA. So quando nao ha administrador do grupo; nunca altera conta
# existente. Propria da homologacao (as de desenvolvimento sao recusadas).
# Depois da troca de senha no primeiro acesso, apague o valor.
DEVORA_BOOTSTRAP_ADMIN_PASSWORD=

# ─── LOGINS PADRÃO (bootstrap) ───
# Senha PROVISÓRIA das 14 contas padrão do grupo: o PDV de cada operação
# (PREÇO JUSTO, ME MIMEI, GRINGA, CONCEITO, PJ MOTORS, OFICINA), o painel
# do gestor de cada uma (ADMIN-<operação>) e as duas bancadas da Oficina
# (OFICINA-PJ MOTORS, OFICINA-PREÇO JUSTO). Sem ela, nenhuma nasce. Conta que
# já existe nunca é alterada. Depois das trocas no primeiro acesso, apague.
DEVORA_BOOTSTRAP_LOGINS_PASSWORD=

# As chaves que so a SUITE de homologacao le (NFCE_TEST_CSC_*, LOGISTICS_*_TOKEN,
# ASAAS_SANDBOX_TESTS...) NAO moram aqui: a suite nao le o .env, e o servidor
# nao as le. Ver docs/DEPLOY.md, secao "Variaveis que so a suite le".

# ─── PUBLICACAO (GAP-PRD-013) ───
#
# A API serve as telas? true = entrega o out/ do `vite build` com fallback de
# SPA (buildar com VITE_API_BASE_URL=/). Ligada sem out/index.html, a API
# recusa subir. false = outro host (nginx/Caddy/CDN) serve as telas.
DEVORA_SERVIR_FRONTEND=true
# Onde esta o build das telas. Vazio = <raiz>/out.
DEVORA_FRONTEND_DIR=
#
# O supervisor (node server/dist/scripts/supervisionar-api.js, que a tarefa do
# Windows sobe) grava o log aqui, um arquivo por dia. Vazio = server/data/logs.
DEVORA_LOG_DIR=
# Quantos dias de log ficam. Vazio ou invalido = 30.
DEVORA_LOG_RETENCAO_DIAS=
# Nome do canal local por onde `parar-api` pede a parada limpa. So troque se
# houver duas instalacoes na mesma maquina (producao e homologacao).
DEVORA_SUPERVISOR_CANAL=
