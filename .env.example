# Frontend (Vite) — variáveis de BUILD, não de runtime.
#
# O frontend lê VITE_API_BASE_URL (src/lib/api/client.ts).
# O valor é EMBUTIDO no bundle no momento do `npm run build:frontend` — trocar
# depois exige rebuildar. Em branco, o navegador deriva o endereço da API do
# host que serviu a página, na porta 8787 — o caso balcão/LAN funciona sem
# configurar nada. Atrás de domínio/proxy, preencha com a origem da API
# (ex.: https://erp.seudominio.com.br).
#
# Os liga/desliga de integração (Asaas, NF-e, logística, TEF...) NÃO são
# variáveis VITE_: vivem no SERVIDOR (ASAAS_ENABLED etc., abaixo) — o
# navegador pergunta ao servidor o que está ligado.
VITE_API_BASE_URL=http://localhost:8787

# Banco central (Supabase/PostgreSQL) — credencial DO SERVIDOR
#
# O SQLite local continua sendo o banco OPERACIONAL: o PDV precisa vender com a
# internet caída. Estas variáveis servem para o servidor subir a fila de fatos
# para a central quando a conexão volta.
#
# A chave publicável acima (VITE_PUBLIC_SUPABASE_ANON_KEY) NÃO serve aqui: ela
# é para leitura no navegador com RLS. Escrever a central com ela significaria
# confiar no navegador. Sem estas duas, o estado é READY_FOR_CREDENTIAL e a
# fila apenas acumula — nada é inventado.
DEVORA_SUPABASE_URL=
DEVORA_SUPABASE_SERVICE_KEY=
# Bucket do Storage onde vai a copia remota do backup. Vazio = "backups".
DEVORA_SUPABASE_BUCKET=
# Identidade deste nó. Em branco, é gerada uma vez e guardada no próprio banco.
# Só preencha se precisar fixar o nome de uma loja específica.
GRUPO_SAMPAIO_NODE_ID=

# Backend DEVORA API — NUNCA prefixar segredos com VITE_
DEVORA_API_ENV=development
# NODE_ENV: NAO defina na bancada. Em producao ele vale como producao para as
# travas (chave fraca e variavel aposentada ligada recusam subir) — o mesmo
# que DEVORA_API_ENV=production.
# NODE_ENV=production
# Todo login exige senha: nao ha variavel que ligue entrada sem senha.
DEVORA_API_PORT=8787
# Onde a API escuta. 127.0.0.1 (o padrao) = so a propria maquina; na VPS quem
# recebe da internet e o Caddy, que encaminha para 127.0.0.1:8787.
DEVORA_API_HOST=127.0.0.1
DEVORA_FRONTEND_ORIGIN=http://localhost:3000

# QUANTOS PROXIES ESTAO NA FRENTE DESTE SERVIDOR.
#
# O limite de taxa e o controle de forca bruta do login contam por IP. Atras de
# um proxy reverso, o IP visto e o DO PROXY: as seis operacoes, todos os caixas
# e todo visitante da vitrine dividem o mesmo balde, e um robo na vitrine
# derruba a venda do balcao com 429.
#
# Ligar faz o servidor acreditar no X-Forwarded-For, que e a coisa mais barata
# de forjar — quem mandar um IP diferente a cada tentativa some do controle de
# forca bruta. Por isso o valor e SEU: e o numero de saltos confiaveis.
#
#   0  servido direto (padrao, e o certo sem proxy)
#   1  um proxy reverso na frente (nginx, Caddy, Traefik)
#   2  CDN na frente do proxy
DEVORA_TRUST_PROXY=0

# O banco. Em branco vale o mesmo caminho abaixo. O nome antigo terminado em
# .json (devora-api.json) ainda e aceito — o servidor o troca por .db —, mas
# criava um banco DIFERENTE do padrao para quem copiava este exemplo.
DEVORA_DATABASE_PATH=./server/data/grupo-sampaio.db
# Endereco publico da loja — e o que o QR da plaquinha do equipamento carrega.
#
# Precisa comecar com http:// ou https://; o servidor recusa subir com um valor
# sem esquema, porque o QR sairia como caminho relativo e nao abriria no celular.
# Em branco, a plaquinha usa https://grupossampaio.com.br e a tela de etiquetas
# avisa que o endereco nao esta configurado ANTES de imprimir — a etiqueta e
# colada no aparelho e fica la por anos.
GRUPO_SAMPAIO_PUBLIC_URL=
DEVORA_JWT_SECRET=change-me-in-production
DEVORA_ENCRYPTION_KEY=change-me-32-chars-minimum-key!!
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_AUTH_TOKEN=
ASAAS_WEBHOOK_PUBLIC_URL=
ASAAS_TIMEOUT_MS=30000
ASAAS_MAX_RETRIES=3
# Minutos entre as consultas automaticas ao Asaas das cobrancas em aberto
# (o webhook perdido nao some da conciliacao). 0 desliga a automatica.
ASAAS_SYNC_INTERVAL_MINUTES=30
ASAAS_PRODUCTION_ENABLED=false
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_BASE_URL=https://api.asaas.com/api/v3
NFE_PRODUCTION_ENABLED=false
NFE_HOMOLOGATION_TESTS=false
NFCE_PRODUCTION_ENABLED=false
NFCE_HOMOLOGATION_TESTS=false
LOGISTICS_EXTERNAL_ENABLED=false
# Permissão do servidor para cotar na produção das transportadoras; o token vai
# pela tela Loja → Logística, por operação.
LOGISTICS_PRODUCTION_ENABLED=false
LOGISTICS_MELHOR_ENVIO_SANDBOX_URL=https://sandbox.melhorenvio.com.br
LOGISTICS_MELHOR_ENVIO_PRODUCTION_URL=https://melhorenvio.com.br
# Correios e Jadlog NÃO têm integração direta (GAP-PRD-118): os serviços deles
# (PAC, SEDEX, .Package) são cotados, comprados e rastreados pelo Melhor Envio.
# As antigas LOGISTICS_JADLOG_TOKEN / LOGISTICS_CORREIOS_* não eram lidas por
# código nenhum e sugeriam que bastava preenchê-las.
# De quantos em quantos minutos a agenda consulta o rastreio dos envios a
# caminho no Melhor Envio. 0 desliga a agenda (o botão da ficha continua).
LOGISTICS_TRACKING_SYNC_MINUTES=60
PAYMENT_TERMINAL_ENABLED=true
PAYMENT_TERMINAL_PRODUCTION_ENABLED=false
PAYMENT_TERMINAL_HOMOLOGATION_TESTS=false
ECOMMERCE_ENABLED=true
ECOMMERCE_PRODUCTION_ENABLED=false
ECOMMERCE_HOMOLOGATION_TESTS=false
ECOMMERCE_STOREFRONT_PUBLIC_BASE_URL=
ECOMMERCE_ADMIN_PUBLIC_URL=
ECOMMERCE_STOREFRONT_CNAME_TARGET=
ECOMMERCE_STOREFRONT_A_RECORD=
ECOMMERCE_DNS_TXT_HOST=_devora-verify
ECOMMERCE_DNS_AUTO_VALIDATE=false
ECOMMERCE_STOREFRONT_ORIGINS=
LOG_LEVEL=info

# ─── ONDE FICAM OS DADOS ───
#
# Backup local: deixe em OUTRO disco (pen drive, segundo HD, pasta
# sincronizada). Vazio = server/data/backups, vizinha do banco, e o servidor
# avisa no log a cada execucao.
# DEVORA_BACKUP_DIR=D:/backups-grupo-sampaio
# Hora do diario (0 a 23), pelo relogio da loja. Vazio = 3 (03:00). A copia
# do banco e o envio das fotos rodam a essa hora; ao subir, o servidor so tira
# copia se nao houver diario de menos de 20 h.
DEVORA_BACKUP_HORA=
# Imagens enviadas (logo de loja, foto de produto, foto de OS). Vazio = os
# caminhos historicos (<raiz>/data/uploads). Trocar depois exige MOVER os
# arquivos junto, senao os links gravados no banco apontam para o nada.
DEVORA_UPLOADS_DIR=
#
# Retencao do bucket (avo-pai-filho). Vazio = 14 diarios, 8 semanais, 12
# mensais, minimo 7. Valor invalido cai no padrao em vez de virar "apague tudo".
DEVORA_BACKUP_RETENCAO_DIARIOS=
DEVORA_BACKUP_RETENCAO_SEMANAIS=
DEVORA_BACKUP_RETENCAO_MENSAIS=
DEVORA_BACKUP_RETENCAO_MINIMO=

# ─── CORREIO DE SAIDA (SMTP) ───
#
# Sem estas, a fila de e-mail ACUMULA em vez de falhar — e nela ficam o codigo
# de verificacao da conta do cliente e a recuperacao de senha. O carteiro sobe
# sempre e diz no log que a credencial falta. EMAIL_ENABLED=false monta e
# enfileira sem mandar nada. A API le estas chaves SO AO SUBIR: mudou, reinicie.
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ─── ADMINISTRADOR INICIAL (bootstrap) ───
# A subida (e `npm run db:bootstrap --prefix server`, o mesmo `db:seed`) cria
# as seis empresas e, num banco sem administrador do grupo, a conta `admin` com
# esta senha, PROVISORIA. Nunca altera conta existente. Em producao, ver
# .env.production.example.
DEVORA_BOOTSTRAP_ADMIN_PASSWORD=

# ─── LOGINS PADRÃO (bootstrap) ───
# Senha PROVISÓRIA das 14 contas padrão do grupo: o PDV de cada operação
# (PREÇO JUSTO, ME MIMEI, GRINGA, CONCEITO, PJ MOTORS, OFICINA), o painel
# do gestor de cada uma (ADMIN-<operação>) e as duas bancadas da Oficina
# (OFICINA-PJ MOTORS, OFICINA-PREÇO JUSTO). Sem ela, nenhuma nasce. Conta que
# já existe nunca é alterada. Depois das trocas no primeiro acesso, apague.
DEVORA_BOOTSTRAP_LOGINS_PASSWORD=

# ─── SEED DE DESENVOLVIMENTO (so na bancada) ───
# `npm run db:seed:dev --prefix server` cria as doze contas de DEMONSTRACAO
# (CARLOSGERENTE, <slug>.pdv, mecanicos, JOAOCELULAR). Recusa producao,
# homologacao e o banco operacional (qualquer grupo-sampaio.db): aponte
# DEVORA_DATABASE_PATH para outro arquivo. Sem estas duas, cada conta ganha uma
# senha gerada, impressa UMA vez.
# GRUPO_SAMPAIO_MANAGEMENT_PASSWORD=
# GRUPO_SAMPAIO_OPERATION_PASSWORD=

# As chaves que so a SUITE de homologacao le (NFCE_TEST_CSC_*, LOGISTICS_*_TOKEN,
# ASAAS_SANDBOX_TESTS...) NAO moram aqui: a suite nao le o .env, e o servidor
# nao as le. Ver docs/DEPLOY.md, secao "Variaveis que so a suite le".

# ─── PUBLICACAO (GAP-PRD-013) ───
#
# A API serve as telas? true = entrega o out/ do `vite build` com fallback de
# SPA (buildar com VITE_API_BASE_URL=/). Ligada sem out/index.html, a API
# recusa subir. false = outro host (nginx/Caddy/CDN) serve as telas.
DEVORA_SERVIR_FRONTEND=false
# Onde esta o build das telas. Vazio = <raiz>/out.
DEVORA_FRONTEND_DIR=
#
# O supervisor (node server/dist/scripts/supervisionar-api.js, que a tarefa do
# Windows sobe) grava o log aqui, um arquivo por dia. Vazio = server/data/logs.
DEVORA_LOG_DIR=
# Quantos dias de log ficam. Vazio ou invalido = 30.
DEVORA_LOG_RETENCAO_DIAS=
# Nome do canal local por onde `parar-api` pede a parada limpa. So troque se
# houver duas instalacoes na mesma maquina (producao e homologacao).
DEVORA_SUPERVISOR_CANAL=
