{
  "name": "@devora/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/status.ts",
    "db:conferir-esquema": "tsx src/db/conferirEsquema.ts",
    "db:bootstrap": "tsx src/db/bootstrap-cli.ts",
    "db:seed": "tsx src/db/bootstrap-cli.ts",
    "db:seed:dev": "tsx src/db/seedDeDesenvolvimento-cli.ts",
    "db:limpar-demonstracao": "tsx src/scripts/limpar-demonstracao.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@xmldom/xmldom": "0.8.15",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.10.1",
    "imapflow": "^1.7.0",
    "jsonwebtoken": "^9.0.2",
    "libxml2-wasm": "0.7.2",
    "mailparser": "^3.9.15",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.5",
    "qrcode-generator": "^2.0.4",
    "uuid": "^11.1.0",
    "xml-crypto": "6.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.10",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}
