{
  "dependencies": {
    "i18next": "25.4.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.3.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "source-map": "^0.7.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "unplugin-auto-import": "^19.3.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.4"
  },
  "name": "react",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "postinstall": "npm ci --prefix server --no-audit --no-fund",
    "build": "npm run build:frontend && npm run build:api",
    "build:frontend": "vite build",
    "build:api": "npm run build --prefix server",
    "dev": "npm run dev:frontend",
    "dev:frontend": "vite",
    "dev:api": "npm run dev --prefix server",
    "lint": "npm run lint:frontend && npm run lint:api",
    "lint:frontend": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:api": "npm run lint --prefix server",
    "preview": "vite preview",
    "test": "npm run test:frontend && npm run test:api",
    "test:frontend": "vitest run",
    "test:api": "npm run test --prefix server",
    "test:asaas:sandbox": "npm run test --prefix server -- tests/asaas.sandbox.test.ts",
    "test:nfe": "npm run test --prefix server -- tests/nfe.test.ts tests/nfe.homologation.test.ts",
    "test:nfe:homologation": "npm run test --prefix server -- tests/nfe.homologation.test.ts",
    "test:nfce": "npm run test --prefix server -- tests/nfce.test.ts tests/nfce.homologation.test.ts",
    "test:nfce:homologation": "npm run test --prefix server -- tests/nfce.homologation.test.ts",
    "test:logistics": "npm run test --prefix server -- tests/logistics.test.ts tests/logistics.homologation.test.ts",
    "test:logistics:homologation": "npm run test --prefix server -- tests/logistics.homologation.test.ts",
    "test:payment-terminal": "npm run test --prefix server -- tests/payment-terminals.test.ts tests/payment-terminal.homologation.test.ts",
    "test:payment-terminal:homologation": "npm run test --prefix server -- tests/payment-terminal.homologation.test.ts",
    "test:ecommerce": "npm run test --prefix server -- tests/ecommerce-core.test.ts tests/ecommerce-jornada.test.ts",
    "test:staging": "npm run test --prefix server -- tests/staging.homologation.test.ts",
    "type-check": "npm run type-check:frontend && npm run type-check:api",
    "type-check:frontend": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.node.json",
    "type-check:api": "npm run type-check --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:status": "npm run db:status --prefix server",
    "backup": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/backup-agora.ts",
    "backup:verify": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/verificar-backup.ts",
    "db:backups": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/listar-backups.ts",
    "db:restore": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/restaurar-backup.ts",
    "db:bucket": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/listar-bucket.ts",
    "db:baixar": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/baixar-backup.ts",
    "db:restaurar-uploads": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/restaurar-uploads.ts",
    "db:restaurar-do-bucket": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/restaurar-do-bucket.ts",
    "db:podar-legado": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/podar-tabelas-aposentadas.ts",
    "secret:scan": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/varredura-de-segredos.ts",
    "implantacao:conferir": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/conferir-implantacao.ts",
    "ibge:municipios": "node server/node_modules/tsx/dist/cli.mjs server/src/scripts/carregar-municipios-ibge.ts",
    "api:supervisionar": "node server/dist/scripts/supervisionar-api.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module"
}
