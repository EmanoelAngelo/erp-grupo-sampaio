# Grupo Sampaio ERP — Produção (.env.production.example)
#
# O runtime da API lê APENAS o arquivo chamado `.env` (na pasta do processo ou
# na pasta pai) — ou as variáveis reais do ambiente. NÃO existe carregamento de
# um arquivo `.env.production`: copie este modelo para `.env` NO SERVIDOR de
# produção e preencha lá. NUNCA commitar o `.env` preenchido.
#
#     copiar: cp .env.production.example .env      (no servidor)
#
# Seções:
#   CORE REQUIRED  — obrigatório para subir o Core
#   EXTERNAL OPTIONAL — integrações (desligadas até homologação)
#   PRODUCTION SAFETY — flags que protegem produção

# ─── CORE REQUIRED / APP ───
DEVORA_API_ENV=production
NODE_ENV=production
LOG_LEVEL=info

# ─── CORE REQUIRED / API ───
DEVORA_API_PORT=8787
DEVORA_FRONTEND_ORIGIN=

# QUANTOS PROXIES ESTAO NA FRENTE DESTE SERVIDOR.
#
# O limite de taxa e o controle de forca bruta do login contam por IP. Atras de
# um proxy reverso, o IP visto e o DO PROXY: as seis operacoes, todos os caixas
# e todo visitante da vitrine dividem o mesmo balde, e um robo na vitrine
# derruba a venda do balcao com 429.
#
# Ligar faz o servidor acreditar no X-Forwarded-For, que e a coisa mais barata
# de forjar — quem mandar um IP diferente a cada tentativa some do controle de
# forca bruta. Por isso o valor e SEU: e o numero de saltos confiaveis.
#
#   0  servido direto (padrao, e o certo sem proxy)
#   1  um proxy reverso na frente (nginx, Caddy, Traefik)
#   2  CDN na frente do proxy
DEVORA_TRUST_PROXY=0


# ─── CORE REQUIRED / Endereco publico da plaquinha ───
# O QR do equipamento aponta para ca. Preencher em producao: a etiqueta e
# impressa uma vez e fica colada no aparelho por anos, entao um endereco errado
# so aparece quando o cliente escaneia — tarde demais.
# Deve comecar com http:// ou https://; sem esquema o servidor nao sobe.
GRUPO_SAMPAIO_PUBLIC_URL=

# ─── CORE REQUIRED / DB ───
DEVORA_DATABASE_PATH=

# ─── CORE REQUIRED / JWT (forte; defaults locais são rejeitados) ───
DEVORA_JWT_SECRET=

# ─── CORE REQUIRED / Encryption ───
DEVORA_ENCRYPTION_KEY=

# GERE AS DUAS ASSIM, na propria maquina, e NAO as copie por chat ou e-mail:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# O servidor RECUSA subir em producao ou homologacao com qualquer uma delas
# ausente, curta, sem entropia, ou igual a um valor de exemplo deste
# repositorio — inclusive os "change-me-*" dos outros arquivos.
#
# TROCAR A DEVORA_ENCRYPTION_KEY DEPOIS NAO E TROCAR UMA CONFIGURACAO.
# Ela sela o .pfx do certificado, as chaves do Asaas e a senha da caixa de
# e-mail. Nao ha segunda copia de nenhum deles. Trocar sem rodar
# `node dist/scripts/rotacionar-chave.js` torna os cinco ilegiveis.

# ─── PRODUCTION SAFETY / entrada sem senha ───
# Nao existe. Todo login exige senha; o unico caminho sem digitar senha e o
# token de terminal, registrado por um administrador e revogavel. Se o .env
# antigo desta maquina ainda tiver a linha de um atalho sem senha, a API
# RECUSA subir em producao com ela ligada e diz qual linha apagar — e a
# conferencia da implantacao mostra "Variavel aposentada presente".

# ─── CENTRAL E BACKUP REMOTO / mesma conta Supabase, um nome so ───
#
# Estas TRES variaveis atendem duas coisas na mesma conta: a copia remota do
# backup (Storage) e a fila de fatos para a central (Postgres).
#
# Ja foram dois nomes. A sincronia lia SUPABASE_URL e
# SUPABASE_SERVICE_ROLE_KEY enquanto o backup lia os DEVORA_*; o .env da
# instalacao tinha os DEVORA_* preenchidos, e o resultado foram 118 eventos
# parados por doze dias, com o log dizendo "sem credencial" a cada boot para
# um dono que tinha preenchido a credencial.
#
# Se o nome antigo estiver no ambiente, o diagnostico do dono o DENUNCIA em
# vez de ignora-lo. Preencher os dois nao ajuda: vale o DEVORA_.
DEVORA_SUPABASE_URL=
DEVORA_SUPABASE_SERVICE_KEY=
DEVORA_SUPABASE_BUCKET=backups

# ─── Frontend (Vite) — variável de BUILD, não de runtime ───
#
# O frontend lê VITE_API_BASE_URL, embutida no
# bundle durante `npm run build:frontend` — defina ANTES de buildar, na
# máquina que builda. Preencha com a origem HTTPS da API vista do navegador
# (ex.: https://erp.seudominio.com.br). Em branco, o bundle deriva
# host-da-página:8787, que só serve para balcão/LAN sem proxy.
#
# Liga/desliga de integrações NÃO são VITE_: são as variáveis do SERVIDOR
# (ASAAS_ENABLED etc., nas seções abaixo).
VITE_API_BASE_URL=

# ─── EXTERNAL OPTIONAL / Asaas ───
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_BASE_URL=
ASAAS_WEBHOOK_AUTH_TOKEN=
ASAAS_WEBHOOK_PUBLIC_URL=
ASAAS_TIMEOUT_MS=30000
ASAAS_MAX_RETRIES=3
ASAAS_PRODUCTION_ENABLED=false
ASAAS_SYNC_INTERVAL_MINUTES=30
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_BASE_URL=

# ─── EXTERNAL OPTIONAL / Fiscal (NF-e / NFC-e) ───
# O CSC da NFC-e e o certificado A1 NAO sao variaveis: entram pela tela Fiscal,
# por operacao, e ficam no cofre.
NFE_PRODUCTION_ENABLED=false
NFE_HOMOLOGATION_TESTS=false
NFCE_PRODUCTION_ENABLED=false
NFCE_HOMOLOGATION_TESTS=false

# ─── EXTERNAL OPTIONAL / Logística ───
# As credenciais das transportadoras (Melhor Envio, Jadlog, Correios) NAO sao
# variaveis: entram pela Central de Integracoes, que as guarda no cofre.
LOGISTICS_EXTERNAL_ENABLED=false
# Permissão do SERVIDOR para cotar na produção das transportadoras. O token de
# produção do Melhor Envio é colado por operação na tela Loja → Logística; com
# esta chave em false ele fica guardado e a tela mostra a trava pelo nome.
LOGISTICS_PRODUCTION_ENABLED=false
LOGISTICS_MELHOR_ENVIO_SANDBOX_URL=
LOGISTICS_MELHOR_ENVIO_PRODUCTION_URL=
# Correios e Jadlog NÃO têm integração direta (GAP-PRD-118): os serviços deles
# (PAC, SEDEX, .Package) são cotados, comprados e rastreados pelo Melhor Envio.
# As antigas LOGISTICS_JADLOG_TOKEN / LOGISTICS_CORREIOS_* não eram lidas por
# código nenhum e sugeriam que bastava preenchê-las.
# De quantos em quantos minutos a agenda consulta o rastreio dos envios a
# caminho no Melhor Envio. 0 desliga a agenda (o botão da ficha continua).
LOGISTICS_TRACKING_SYNC_MINUTES=60

# ─── EXTERNAL OPTIONAL / Payment Terminal ───
PAYMENT_TERMINAL_ENABLED=true
PAYMENT_TERMINAL_PRODUCTION_ENABLED=false
PAYMENT_TERMINAL_HOMOLOGATION_TESTS=false

# ─── EXTERNAL OPTIONAL / E-commerce ───
ECOMMERCE_ENABLED=true
ECOMMERCE_PRODUCTION_ENABLED=false
ECOMMERCE_HOMOLOGATION_TESTS=false
ECOMMERCE_STOREFRONT_PUBLIC_BASE_URL=
ECOMMERCE_ADMIN_PUBLIC_URL=
ECOMMERCE_STOREFRONT_CNAME_TARGET=
ECOMMERCE_STOREFRONT_A_RECORD=
ECOMMERCE_DNS_TXT_HOST=
ECOMMERCE_DNS_AUTO_VALIDATE=false
ECOMMERCE_STOREFRONT_ORIGINS=

# ─── ADMINISTRADOR INICIAL (bootstrap) ───
#
# A primeira subida cria as seis empresas e UMA conta: login `admin`, nome
# Administrador, com ESTA senha, marcada como PROVISORIA (o primeiro login abre
# a troca obrigatoria e a API recusa o resto ate la). Nenhuma conta de
# demonstracao e criada: PDVs, gerentes e mecanicos o admin cadastra pela tela
# Usuarios e equipe.
#
# Ela so cria quando ainda nao existe administrador do grupo nem conta `admin`,
# e NUNCA altera senha de conta existente. Minimo de 8 caracteres; as senhas de
# desenvolvimento sao recusadas. Nunca aparece em log, auditoria nem tela.
#
# Roteiro: preencha, suba a API (ou rode `npm run db:bootstrap --prefix server`
# com ela parada), entre como admin, troque a senha e APAGUE o valor daqui.
DEVORA_BOOTSTRAP_ADMIN_PASSWORD=

# ─── LOGINS PADRÃO (bootstrap) ───
# Senha PROVISÓRIA das 14 contas padrão do grupo: o PDV de cada operação
# (PREÇO JUSTO, ME MIMEI, GRINGA, CONCEITO, PJ MOTORS, OFICINA), o painel
# do gestor de cada uma (ADMIN-<operação>) e as duas bancadas da Oficina
# (OFICINA-PJ MOTORS, OFICINA-PREÇO JUSTO). Sem ela, nenhuma nasce. Conta que
# já existe nunca é alterada. Depois das trocas no primeiro acesso, apague.
DEVORA_BOOTSTRAP_LOGINS_PASSWORD=

# Identidade deste no na sincronia com a central. Em branco, e gerada uma vez e
# guardada no proprio banco — o que basta para uma instalacao so.
GRUPO_SAMPAIO_NODE_ID=

# ─── ONDE O BACKUP LOCAL MORA ───
#
# Vazio = `server/data/backups`, a pasta VIZINHA do banco. Disco morre, morrem
# os dois — e e por isso que o diagnostico do dono responde
# LOCAL_BACKUP_SEPARATE_MEDIA: NO enquanto isto nao for preenchido.
#
# Aponte para outro disco, um volume persistente da hospedagem, um pen drive ou
# uma pasta sincronizada. Nao invente um caminho que nao existe: com o destino
# indefinido, a protecao real e a copia remota.
DEVORA_BACKUP_DIR=

# Hora do diario (0 a 23), pelo relogio da loja. Vazio = 3 (03:00). A copia
# do banco e o envio das fotos rodam a essa hora; ao subir, o servidor so tira
# copia se nao houver diario de menos de 20 h.
DEVORA_BACKUP_HORA=

# Onde ficam as imagens enviadas (logo de loja, foto de produto, foto de OS).
# Vazio = os caminhos historicos. Preencher so se o volume persistente da
# hospedagem estiver em outro lugar — e entao MOVA os arquivos junto, senao os
# links ja gravados no banco apontam para o nada.
DEVORA_UPLOADS_DIR=

# ─── RETENCAO DO BUCKET ───
#
# Avo-pai-filho. Vazio = os padroes, que sao: 14 dias de diarios (o intervalo
# entre um defeito entrar e alguem notar), 8 semanas de semanais (quando se
# descobre que um lancamento vinha errado), 12 meses de mensais (o ano fiscal).
# Minimo 7, e valor invalido cai no padrao em vez de virar "apague tudo".
#
# A poda NAO e automatica: e o comando `node dist/scripts/podar-bucket.js`,
# com ensaio obrigatorio antes.
DEVORA_BACKUP_RETENCAO_DIARIOS=
DEVORA_BACKUP_RETENCAO_SEMANAIS=
DEVORA_BACKUP_RETENCAO_MENSAIS=
DEVORA_BACKUP_RETENCAO_MINIMO=

# ─── CORREIO DE SAIDA (SMTP) ───
#
# Sem estas, a fila de e-mail ACUMULA em vez de falhar — e nela ficam o codigo
# de verificacao da conta do cliente e a recuperacao de senha. O carteiro sobe
# sempre e diz no log que a credencial falta.
#
# A senha de app do Gmail e uma das credenciais que precisam ser REGERADAS
# antes do go-live: ela ficou guardada em copias do banco seladas com a chave
# publicada.
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ─── PUBLICACAO (GAP-PRD-013) ───
#
# A API serve as telas? true = entrega o out/ do `vite build` com fallback de
# SPA (buildar com VITE_API_BASE_URL=/). Ligada sem out/index.html, a API
# recusa subir. false = outro host (nginx/Caddy/CDN) serve as telas.
DEVORA_SERVIR_FRONTEND=true
# Onde esta o build das telas. Vazio = <raiz>/out.
DEVORA_FRONTEND_DIR=
#
# O supervisor (node server/dist/scripts/supervisionar-api.js, que a tarefa do
# Windows sobe) grava o log aqui, um arquivo por dia. Vazio = server/data/logs.
DEVORA_LOG_DIR=
# Quantos dias de log ficam. Vazio ou invalido = 30.
DEVORA_LOG_RETENCAO_DIAS=
# Nome do canal local por onde `parar-api` pede a parada limpa. So troque se
# houver duas instalacoes na mesma maquina (producao e homologacao).
DEVORA_SUPERVISOR_CANAL=

# As chaves que so a SUITE de homologacao le (NFCE_TEST_CSC_*, LOGISTICS_*_TOKEN,
# ASAAS_SANDBOX_TESTS...) NAO moram aqui: a suite nao le o .env, e o servidor
# nao as le. Ver docs/DEPLOY.md, secao "Variaveis que so a suite le".
